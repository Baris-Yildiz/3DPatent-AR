      <memberdef kind="function" id="class_pivot_setter_1a315511afac34fb1335e32d90b150307f" prot="public" static="yes" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>void</type>
        <definition>static void PivotSetter.SnapToYOffset</definition>
        <argsstring>(GameObject patent, bool toGround, bool usePivot)</argsstring>
        <name>SnapToYOffset</name>
        <qualifiedname>PivotSetter.SnapToYOffset</qualifiedname>
        <param>
          <type>GameObject</type>
          <declname>patent</declname>
        </param>
        <param>
          <type>bool</type>
          <declname>toGround</declname>
        </param>
        <param>
          <type>bool</type>
          <declname>usePivot</declname>
        </param>
        <briefdescription>
<para>Adjusts the Y position of <emphasis>patent</emphasis>  so its bottom face sits on the detected AR plane (when <emphasis>toGround</emphasis>  is <computeroutput>true</computeroutput>) or its center aligns with the spawn Y coordinate. </para>
        </briefdescription>
        <detaileddescription>
<para>Also re-centres the XZ pivot relative to the bounds center.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>patent</parametername>
</parameternamelist>
<parameterdescription>
<para>The root GameObject to reposition.</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>toGround</parametername>
</parameternamelist>
<parameterdescription>
<para><computeroutput>true</computeroutput> to snap the bottom of the model to the plane surface; <computeroutput>false</computeroutput> to align the center. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>usePivot</parametername>
</parameternamelist>
<parameterdescription>
<para><computeroutput>true</computeroutput> to treat the transform position as the pivot point; <computeroutput>false</computeroutput> to use the bounds center. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
