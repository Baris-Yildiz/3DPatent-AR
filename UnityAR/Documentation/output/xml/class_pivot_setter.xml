<parameternamelist>
<parametername>patent</parametername>
</parameternamelist>
<parameterdescription>
<para>The root GameObject whose renderers are measured.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The encapsulating Bounds in world space, or a zero-size bounds at the object&apos;s position if no renderers are found. </para>
</simplesect>
</para>
        </detaileddescription>
