      <memberdef kind="function" id="class_pivot_setter_1a10446c1260fc67247e5c00af3917c223" prot="public" static="yes" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>Bounds</type>
        <definition>static Bounds PivotSetter.GetBounds</definition>
        <argsstring>(GameObject patent)</argsstring>
        <name>GetBounds</name>
        <qualifiedname>PivotSetter.GetBounds</qualifiedname>
        <param>
          <type>GameObject</type>
          <declname>patent</declname>
        </param>
        <briefdescription>
<para>Computes the local-space axis-aligned bounding box of <emphasis>patent</emphasis>  by transforming all mesh-corner vertices into the root object&apos;s local space. </para>
        </briefdescription>
        <detaileddescription>
<para>More accurate than GetSpawnBounds for rotated hierarchies.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>patent</parametername>
</parameternamelist>
<parameterdescription>
<para>The root GameObject whose mesh filters are measured.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The local-space Bounds, or a small default if no meshes exist.</para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
