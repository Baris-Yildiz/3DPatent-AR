    <compoundname>PivotSetter</compoundname>
    <sectiondef kind="public-static-func">
      <memberdef kind="function" id="class_pivot_setter_1a2ba93b3c2ee0b518eeaa1694f7835b1d" prot="public" static="yes" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>Vector3</type>
        <definition>static Vector3 PivotSetter.ChangeToOneOneMode</definition>
        <argsstring>(GameObject patent, Transform camTransform, float offSet)</argsstring>
        <name>ChangeToOneOneMode</name>
        <qualifiedname>PivotSetter.ChangeToOneOneMode</qualifiedname>
        <param>
          <type>GameObject</type>
          <declname>patent</declname>
        </param>
        <param>
          <type>Transform</type>
          <declname>camTransform</declname>
        </param>
        <param>
          <type>float</type>
          <declname>offSet</declname>
        </param>
        <briefdescription>
<para>Repositions <emphasis>patent</emphasis>  so its bounding box no longer overlaps the camera position in the XZ plane, pushing it along the camera&apos;s forward direction when the camera is inside the model bounds. </para>
        </briefdescription>
        <detaileddescription>
<para>Used when switching to 1:1 real-world scale mode.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>patent</parametername>
</parameternamelist>
<parameterdescription>
<para>The root GameObject of the patent model.</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>camTransform</parametername>
</parameternamelist>
<parameterdescription>
<para>The AR camera transform.</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>offSet</parametername>
</parameternamelist>
<parameterdescription>
<para>Extra clearance distance in metres beyond the model edge.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The calculated offset vector (currently always Vector3.zero), or Vector3.positiveInfinity if <emphasis>patent</emphasis>  is null. </para>
</simplesect>
</para>
        </detaileddescription>
