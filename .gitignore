# This .gitignore file should be placed at the root of your repository
# It ignores all Unity-generated files under UnityAR/ArTest/

# Base Unity folders
/UnityAR/ArTest/[Ll]ibrary/
/UnityAR/ArTest/[Tt]emp/
/UnityAR/ArTest/[Oo]bj/
/UnityAR/ArTest/[Bb]uild/
/UnityAR/ArTest/[Bb]uilds/
/UnityAR/ArTest/[Ll]ogs/
/UnityAR/ArTest/[Uu]ser[Ss]ettings/
*.log

# By default Unity supports Blender asset imports, *.blend1 files don’t need to be committed
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/UnityAR/ArTest/[Mm]emoryCaptures/

# Recordings can get excessive in size
/UnityAR/ArTest/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /UnityAR/ArTest/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/UnityAR/ArTest/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
/UnityAR/ArTest/.vs/

# Gradle cache directory
/UnityAR/ArTest/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/UnityAR/ArTest/ExportedObj/
/UnityAR/ArTest/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/UnityAR/ArTest/ServerData
/UnityAR/ArTest/[Aa]ssets/StreamingAssets/aa*
/UnityAR/ArTest/[Aa]ssets/AddressableAssetsData/link.xml*
/UnityAR/ArTest/[Aa]ssets/Addressables_Temp*
/UnityAR/ArTest/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/UnityAR/ArTest/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/UnityAR/ArTest/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/UnityAR/ArTest/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/UnityAR/ArTest/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/UnityAR/ArTest/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# --- Additional recommended ignores ---

# Bee build system intermediates
/UnityAR/ArTest/[Ll]ibrary/Bee/

# Burst compilation artifacts
/UnityAR/ArTest/[Ll]ibrary/BurstCache/
/UnityAR/ArTest/[Bb]urstDebugInformation_DoNotShip/

# IL2CPP build cache
/UnityAR/ArTest/[Ll]ibrary/Il2cppBuildCache/

# Player build cache
/UnityAR/ArTest/[Ll]ibrary/PlayerDataCache/

# Script compilation cache (sometimes missed)
*.rsp
*.response

# Local package cache
/UnityAR/ArTest/[Pp]ackages/com.unity.package-manager/

/UnityAR/ArTest/[Pp]ackages/packages-lock.json

# Local development packages (if you use embedded custom packages)
# /UnityAR/ArTest/Packages/

# Crash dumps and profiling data
*.dmp
*.heap
*.stackdump
/UnityAR/ArTest/[Pp]rofiling/

# Editor-only settings (local machine)
*.swp
*.swm
*.tmp
*.bak
*.orig

# Rider / VSCode settings (local machine)
/UnityAR/ArTest/.idea/
/UnityAR/ArTest/.vscode/

# Unity Collaborate and Plastic SCM local data
/UnityAR/ArTest/[Cc]ollab/
/UnityAR/ArTest/PlasticSCM/

# Platform-specific build caches
/UnityAR/ArTest/[Ll]ibrary/Artifacts/
